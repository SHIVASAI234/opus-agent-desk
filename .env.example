# Copy to .env (never commit .env). In Codespaces, prefer repository secrets instead.
# Fill in only the providers you have; the rest are skipped.

# Market data (tried in this order: Polygon, Twelve Data, Finnhub, Alpha Vantage)
POLYGON_API_KEY=
TWELVEDATA_API_KEY=
FINNHUB_API_KEY=
ALPHAVANTAGE_API_KEY=

# News (Finnhub and Alpha Vantage keys above also cover news + earnings dates)
NEWSAPI_API_KEY=
MARKETAUX_API_KEY=

# Optional: Claude classifies headlines when news.use_llm is true
ANTHROPIC_API_KEY=

# Safety: the app refuses to start if these are anything else.
MODE=paper
ALLOW_LIVE_ORDERS=false
